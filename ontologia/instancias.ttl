<https://pedromota07.github.io/conecta-academico/ontologia/instancias.ttl> a schema:Dataset ;
    ca:fonteEditorial "As correspondências externas das áreas de conhecimento apontam para itens do Wikidata, cujos dados estruturados são disponibilizados sob CC0 1.0."@pt-BR,
        "Os perfis de Ana e João foram adaptados dos modelos fictícios do professor Tiago Cruz de França para a disciplina Web Semântica da UFRRJ. Os demais perfis, a instituição, as unidades e as relações entre registros foram elaborados para esta demonstração e não descrevem pessoas ou unidades reais."@pt-BR ;
    ca:instituicaoReferencia "Universidade Demonstrativa"@pt-BR .

inst:grupo-dados-publicos a ca:GrupoPesquisa ;
    ca:associadoAoProjeto inst:projeto-dados-abertos ;
    ca:linhaAtuacao "Interoperabilidade e publicação de dados acadêmicos."@pt-BR ;
    ca:temMembro inst:pessoa-ana,
        inst:pessoa-joao ;
    schema:identifier "grupo-dados-publicos" ;
    schema:name "Grupo de Dados Públicos e Conhecimento"@pt-BR .

inst:grupo-memoria-digital a ca:GrupoPesquisa ;
    ca:associadoAoProjeto inst:projeto-acervos-digitais,
        inst:projeto-curadoria-digital ;
    ca:linhaAtuacao "Descrição e preservação de coleções digitais."@pt-BR ;
    ca:temMembro inst:pessoa-clara,
        inst:pessoa-rafael ;
    schema:identifier "grupo-memoria-digital" ;
    schema:name "Grupo de Estudos de Memória Digital"@pt-BR .

