inst:publicacao-representacao-conhecimento a ca:Publicacao ;
    dcterms:title "Representação do conhecimento em diretórios acadêmicos"@pt-BR ;
    ca:anoPublicacao 2022 ;
    ca:temAutor inst:pessoa-ana ;
    ca:tipoProducao "artigo" ;
    schema:author inst:pessoa-ana ;
    schema:identifier "publicacao-representacao-conhecimento" .

inst:area-desenvolvimento-web a skos:Concept,
        ca:AreaConhecimento ;
    skos:definition "Construção de recursos e aplicações usados por meio da Web."@pt-BR ;
    skos:inScheme <https://pedromota07.github.io/conecta-academico/ontologia/instancias.ttl#esquema/areas> ;
    skos:prefLabel "Desenvolvimento web"@pt-BR ;
    schema:identifier "area-desenvolvimento-web" .

inst:area-web-semantica a skos:Concept,
        ca:AreaConhecimento ;
    skos:closeMatch <http://www.wikidata.org/entity/Q54837> ;
    skos:definition "Representação e interligação de informações na Web com significado explícito."@pt-BR ;
    skos:inScheme <https://pedromota07.github.io/conecta-academico/ontologia/instancias.ttl#esquema/areas> ;
    skos:prefLabel "Web Semântica"@pt-BR ;
    schema:identifier "area-web-semantica" .

inst:curso-biblioteconomia a ca:CursoGraduacao ;
    ca:incluiDisciplina inst:disciplina-curadoria-digital,
        inst:disciplina-organizacao-informacao ;
    ca:temUnidadeResponsavel inst:unidade-gestao-informacao ;
    schema:identifier "curso-biblioteconomia" ;
    schema:name "Bacharelado em Biblioteconomia"@pt-BR .

inst:curso-sistemas-informacao a ca:CursoGraduacao ;
    ca:incluiDisciplina inst:disciplina-banco-dados,
        inst:disciplina-web-semantica ;
    ca:temUnidadeResponsavel inst:unidade-computacao ;
    schema:identifier "curso-sistemas-informacao" ;
    schema:name "Bacharelado em Sistemas de Informação"@pt-BR .

inst:projeto-acervos-digitais a ca:ProjetoPesquisa ;
    dcterms:description "Atribui termos de assunto a uma coleção didática piloto e compara buscas feitas antes e depois da indexação."@pt-BR ;
    dcterms:title "Curadoria de acervos digitais para ensino"@pt-BR ;
    ca:temParticipante inst:pessoa-clara ;
    schema:identifier "projeto-acervos-digitais" .

inst:projeto-curadoria-digital a ca:ProjetoPesquisa ;
    dcterms:description "Reúne critérios para selecionar, descrever e preservar coleções usadas no ensino e os registra em um guia de procedimentos para o laboratório."@pt-BR ;
    dcterms:title "Curadoria de acervos digitais"@pt-BR ;
    ca:temParticipante inst:pessoa-rafael ;
    schema:identifier "projeto-curadoria-digital" .

inst:projeto-dados-abertos a ca:ProjetoPesquisa ;
    dcterms:description "Converte os registros de um diretório acadêmico em RDF, define identificadores estáveis para pessoas, cursos e projetos e testa consultas SPARQL sobre vínculos e autoria."@pt-BR ;
    dcterms:title "Catálogo acadêmico de dados abertos"@pt-BR ;
    ca:temParticipante inst:pessoa-ana,
        inst:pessoa-joao ;
    schema:identifier "projeto-dados-abertos" .

inst:unidade-ciencias-exatas a ca:UnidadeAcademica ;
    ca:tipoUnidade "instituto" ;
    schema:identifier "unidade-ciencias-exatas" ;
