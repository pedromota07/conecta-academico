    ca:tipoUnidade "departamento" ;
    schema:identifier "unidade-computacao" ;
    schema:name "Departamento de Computação"@pt-BR .

inst:unidade-gestao-informacao a ca:Departamento,
        ca:UnidadeAcademica ;
    ca:temUnidadeSuperior inst:unidade-ciencias-informacao ;
    ca:tipoUnidade "departamento" ;
    schema:identifier "unidade-gestao-informacao" ;
    schema:name "Departamento de Gestão da Informação"@pt-BR .

inst:pessoa-clara a ca:Discente,
        ca:Pessoa ;
    dcterms:description "Estudo como descrever e preservar coleções digitais. No laboratório, elaboro registros de catalogação e avalio se os termos escolhidos ajudam outras pessoas a encontrar materiais no acervo."@pt-BR ;
    ca:cursaDisciplina inst:disciplina-organizacao-informacao ;
    ca:formacao "Bacharelado em Biblioteconomia, em andamento, com ingresso em 2025"@pt-BR ;
    ca:matriculadoEm inst:curso-biblioteconomia ;
    ca:temInteresseEmArea inst:area-curadoria-digital,
        inst:area-gestao-informacao ;
    ca:temVinculoDiscente inst:unidade-gestao-informacao ;
    schema:identifier "pessoa-clara" ;
    schema:mainEntityOfPage <https://pedromota07.github.io/conecta-academico/perfis/pessoa-clara.html> ;
    schema:name "Clara Nunes"@pt-BR .

inst:pessoa-joao a ca:Discente,
        ca:Pessoa ;
    dcterms:description "Estudo desenvolvimento web e organização de dados. No projeto do catálogo acadêmico, ajudo a converter os registros do diretório em arquivos que podem ser consultados e reaproveitados por outras aplicações."@pt-BR ;
    ca:cursaDisciplina inst:disciplina-banco-dados,
        inst:disciplina-web-semantica ;
    ca:formacao "Bacharelado em Sistemas de Informação, em andamento, com ingresso em 2024"@pt-BR ;
    ca:matriculadoEm inst:curso-sistemas-informacao ;
    ca:temInteresseEmArea inst:area-dados-abertos,
        inst:area-desenvolvimento-web ;
    ca:temVinculoDiscente inst:unidade-computacao ;
    schema:identifier "pessoa-joao" ;
    schema:mainEntityOfPage <https://pedromota07.github.io/conecta-academico/perfis/pessoa-joao.html> ;
    schema:name "João Pereira"@pt-BR .

inst:pessoa-rafael a ca:Docente,
        ca:Pessoa ;
    dcterms:description "Pesquiso práticas de curadoria para acervos digitais. Em sala, trabalho com organização da informação e ajudo estudantes a descrever coleções que possam ser consultadas e preservadas ao longo do tempo."@pt-BR ;
    ca:atuaEmArea inst:area-curadoria-digital ;
    ca:cargo "Professor adjunto"@pt-BR ;
    ca:formacao "Doutorado em Ciência da Informação, concluído em 2019"@pt-BR,
        "Graduação em Biblioteconomia, concluída em 2010"@pt-BR,
        "Mestrado em Memória Social, concluído em 2013"@pt-BR ;
    ca:ministraDisciplina inst:disciplina-curadoria-digital,
        inst:disciplina-organizacao-informacao ;
    ca:temVinculoDocente inst:unidade-gestao-informacao ;
    schema:identifier "pessoa-rafael" ;
    schema:mainEntityOfPage <https://pedromota07.github.io/conecta-academico/perfis/pessoa-rafael.html> ;
    schema:name "Rafael Duarte"@pt-BR .

inst:area-gestao-informacao a skos:Concept,
        ca:AreaConhecimento ;
    skos:definition "Organização e uso da informação ao longo de seu ciclo de vida."@pt-BR ;
    skos:inScheme <https://pedromota07.github.io/conecta-academico/ontologia/instancias.ttl#esquema/areas> ;
    skos:prefLabel "Gestão da informação"@pt-BR ;
    schema:identifier "area-gestao-informacao" .

<https://pedromota07.github.io/conecta-academico/ontologia/instancias.ttl#esquema/areas> a skos:ConceptScheme .

inst:pessoa-ana a ca:Docente,
        ca:Pessoa ;
    dcterms:description "Ensino Computação e pesquiso formas de organizar, publicar e interligar dados acadêmicos. Meus projetos combinam Web Semântica e engenharia de conhecimento para facilitar o acesso à informação científica."@pt-BR ;
    ca:atuaEmArea inst:area-dados-abertos,
        inst:area-web-semantica ;
    ca:cargo "Professora associada"@pt-BR ;
    ca:formacao "Doutorado em Ciência da Computação, concluído em 2018"@pt-BR,
        "Graduação em Sistemas de Informação, concluída em 2009"@pt-BR,
        "Mestrado em Informática, concluído em 2012"@pt-BR ;
    ca:ministraDisciplina inst:disciplina-banco-dados,
        inst:disciplina-web-semantica ;
    ca:temVinculoDocente inst:unidade-computacao ;
    schema:identifier "pessoa-ana" ;
    schema:mainEntityOfPage <https://pedromota07.github.io/conecta-academico/perfis/pessoa-ana.html> ;
    schema:name "Ana Silva"@pt-BR .
